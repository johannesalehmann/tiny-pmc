mdp

label "goal" = x=N & y=0;

const double delta = 0.0001;
const int N = 1000;

module main
    x: [0..N] init 0;
    y: [0..2] init 0;

    [] (x<N-1 & y=0) -> 1.0-delta: (x'=x+1) + delta: (y'=1);
    [] (x<N-1 & y=1) -> (y'=0);
    [] (x<N-1 & y=0) -> delta: (x'=x+1) + 1.0-delta: (y'=1);

    [] (x=N-1) -> 0.6: (x'=N)&(y'=0) + 0.4: (x'=N)&(y'=1);
    [] (x=N) -> true;
endmodule